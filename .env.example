# Copy this file to .env and fill in ONE provider's key. Never commit .env.

# Which LLM provider to use: gemini | anthropic | openai | groq | openrouter | ollama
# If unset, the first provider whose API key is set below is used.
LLM_PROVIDER=gemini

# Optional model override (defaults: gemini-3.8-flash, claude-sonnet-5-5, gpt-4.1,
# llama-3.3-70b-versatile, ...)
LLM_MODEL=

# API keys - set only the one you use
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional tuning
# LLM_BASE_URL=          # override the OpenAI-compatible endpoint
# LLM_MAX_TOKENS=8192
# LLM_TIMEOUT=300           # seconds per LLM request
# LLM_REASONING_EFFORT=low  # gemini/openai thinking budget: low | medium | high | none ('' to omit)
# LLM_TEMPERATURE=0
# AGENT_MAX_STEPS=60
# AGENT_TIME_BUDGET=1500
